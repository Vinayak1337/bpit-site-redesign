generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

model HeaderContactSetting {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  phoneTel             String
  phoneDisplay         String
  email                String
  address              String
  mapUrl               String
  accreditationMobile  String
  accreditationDesktop String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model HeaderAnnouncement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  href      String
  order     Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FooterContactInfo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String
  title     String
  text      String
  href      String
  order     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FooterBottomInfo {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  copyright     String
  accreditation String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
